function loadMacroFromFile(mName)
    local fileName = FOLDER_NAME .. "/" .. mName .. ".json"
    if not isfile or not isfile(fileName) then
        logConsole("File " .. mName .. " tidak ditemukan!")
        return false
    end
    
    local success, res = pcall(function()
        local content = readfile(fileName)
        local data = HttpService:JSONDecode(content)
        
        recordedData = {}
        recordedTowers = {}
        
        if data.Record then
            for _, act in ipairs(data.Record) do
                local remoteObj = ReplicatedStorage:FindFirstChild(act.RemoteName, true)
                table.insert(recordedData, {
                    Type = act.Type, 
                    Time = act.Time, 
                    Remote = remoteObj or ReplicatedStorage,
                    RemoteName = act.RemoteName, 
                    Method = act.Method, 
                    Args = deserializeVal(act.Args),
                    TowerIndex = act.TowerIndex or act.TargetIndex or 1,
                    TargetIndex = act.TargetIndex or act.TowerIndex or 1,
                    PositionCF = act.PositionCF and deserializeVal(act.PositionCF) or nil,
                    CashCost = act.CashCost or 150,
                    TowerIDs = act.TowerIDs or {}
                })
            end
        end
        
        if data.Towers then
            for idxStr, tInfo in pairs(data.Towers) do
                local idx = tonumber(idxStr)
                recordedTowers[idx] = { 
                    Index = tInfo.Index or idx, 
                    PositionCF = tInfo.PositionCF and deserializeVal(tInfo.PositionCF) or nil, 
                    IDs = tInfo.IDs or {} 
                }
            end
        end
        return true
    end)
    
    if success then
        logConsole("Berhasil Load (Kompatibel): " .. mName .. " (" .. #recordedData .. " aksi)")
        return true
    else
        logConsole("Gagal membaca file makro!")
        return false
    end
end

