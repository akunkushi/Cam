------------------------------------------------------------------ CASH
local cashObj, cashLabel, guiCash
local function matchCash(n)
	n = n:lower()
	for _, k in ipairs(CFG.CASH_NAMES) do if n == k then return true end end
end
local function findCash()
	local ls = LP:FindFirstChild("leaderstats")
	if ls then
		for _, v in ipairs(ls:GetChildren()) do
			if v:IsA("ValueBase") and matchCash(v.Name) then return v end
		end
	end
	for _, v in ipairs(LP:GetDescendants()) do
		if v:IsA("ValueBase") and matchCash(v.Name) and type(v.Value) == "number" then return v end
	end
end
local function getCash()
	if not cashObj or not cashObj.Parent then cashObj = findCash() end
	if cashObj then return tonumber(cashObj.Value) end
	for _, k in ipairs(CFG.CASH_NAMES) do
		local a = LP:GetAttribute(k) or LP:GetAttribute(k:sub(1, 1):upper() .. k:sub(2))
		if a then return tonumber(a) end
	end
	if not guiCash or not guiCash.Parent then
		local pg = LP:FindFirstChild("PlayerGui")
		if pg then
			for _, v in ipairs(pg:GetDescendants()) do
				if v:IsA("TextLabel") and matchCash(v.Name) and v.Text:match("%d") then
					guiCash = v break
				end
			end
		end
	end
	if guiCash then
		local digits = guiCash.Text:gsub("[^%d]", "")
		return tonumber(digits)
	end
	return nil
end

------------------------------------------------------------------ TOWER HELPERS
local towerFolder
local function getFolder()
	if not towerFolder or not towerFolder.Parent then
		towerFolder = nil
		for _, n in ipairs(CFG.TOWER_FOLDERS) do
			local f = workspace:FindFirstChild(n, true)
			if f then towerFolder = f break end
		end
	end
	return towerFolder
end
local function towerCount()
	local f = getFolder()
	return f and #f:GetChildren() or nil
end
local function snapshot()
	local s, f = {}, getFolder()
	if f then for _, c in ipairs(f:GetChildren()) do s[c] = true end end
	return s
end

local claimed = {}
local function findNew(before, timeout)
	local t = os.clock()
	repeat
		local f = getFolder()
		if f then
			for _, c in ipairs(f:GetChildren()) do
				if not before[c] and not claimed[c] then return c end
			end
		end
		task.wait(0.1)
	until os.clock() - t > timeout
end

local function getPos(inst)
	local ok, p = pcall(function() return inst:GetPivot().Position end)
	return ok and p or nil
end

local function keysOf(inst)
	local out = { { key = inst.Name, kind = { t = "name" } } }
	for n, v in pairs(inst:GetAttributes()) do
		if type(v) == "string" then table.insert(out, { key = v, kind = { t = "attr", n = n } }) end
	end
	for _, c in ipairs(inst:GetChildren()) do
		if c:IsA("StringValue") then table.insert(out, { key = c.Value, kind = { t = "child", n = c.Name } }) end
	end
	return out
end

local function readKey(inst, kind)
	if kind.t == "name" then return inst.Name
	elseif kind.t == "attr" then return inst:GetAttribute(kind.n)
	elseif kind.t == "child" then
		local c = inst:FindFirstChild(kind.n)
		return c and c.Value
	end
end

local function verifyAction(kind, res, cashBefore, countBefore)
	if res == false then return false end
	if res == true or typeof(res) == "Instance" then return true end
	if kind ~= "sell" and isGuid(res) then return true end
	local t = os.clock()
	repeat
		local c, cash = towerCount(), getCash()
		if kind == "place" then
			if c and countBefore and c > countBefore then return true end
			if cash and cashBefore and cash < cashBefore then return true end
		elseif kind == "upgrade" then
			if cash and cashBefore and cash < cashBefore then return true end
		elseif kind == "sell" then
			if c and countBefore and c < countBefore then return true end
			if cash and cashBefore and cash > cashBefore then return true end
		end
		task.wait(0.1)
	until os.clock() - t > CFG.VERIFY_TIMEOUT
	return false
end

local function remoteByName(name)
	local r = RS:FindFirstChild("Remotes")
	r = r and r:FindFirstChild("Functions")
	return r and r:FindFirstChild(name)
end
local function eventByName(name)
	local r = RS:FindFirstChild("Remotes")
	r = r and r:FindFirstChild("Events")
	return r and r:FindFirstChild(name)
end

