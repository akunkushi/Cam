local lastValidCash = 500
local function getPlayerCash()
    local success, cash = pcall(function()
        if LocalPlayer:FindFirstChild("leaderstats") then
            for _, stat in ipairs(LocalPlayer.leaderstats:GetChildren()) do
                if stat:IsA("ValueBase") and typeof(stat.Value) == "number" then
                    lastValidCash = stat.Value
                    return stat.Value
                end
            end
        end
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        if pg then
            for _, gui in ipairs(pg:GetDescendants()) do
                if gui:IsA("TextLabel") then
                    local nameLower = gui.Name:lower()
                    local text = gui.Text
                    if nameLower:find("cash") or nameLower:find("money") or nameLower:find("coin") or nameLower:find("balance") then
                        local num = tonumber(text:gsub("[^%d]", ""))
                        if num and num >= 0 and num < 10000000 then
                            lastValidCash = num
                            return num
                        end
                    end
                end
            end
        end
        return lastValidCash
    end)
    return success and cash or lastValidCash
end

