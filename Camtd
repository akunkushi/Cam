local function teleportToElevator(elevatorCode)
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local targetElevator = nil
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj.Name == elevatorCode then
            targetElevator = obj
            break
        end
    end

    if targetElevator then
        local cf = targetElevator:GetPivot()
        root.CFrame = cf + Vector3.new(0, 3, 0)
    end
end

local function serializeVal(v)
    if typeof(v) == "CFrame" then
        return {__type = "CFrame", c = {v:GetComponents()}}
    elseif typeof(v) == "Vector3" then
        return {__type = "Vector3", x = v.X, y = v.Y, z = v.Z}
    elseif typeof(v) == "Instance" then
        return {__type = "Instance", name = v.Name, className = v.ClassName}
    elseif type(v) == "table" then
        local res = {}
        for k, val in pairs(v) do
            res[tostring(k)] = serializeVal(val)
        end
        return res
    else
        return v
    end
end

local function deserializeVal(v)
    if type(v) == "table" then
        if v.__type == "CFrame" then
            return CFrame.new(unpack(v.c))
        elseif v.__type == "Vector3" then
            return Vector3.new(v.x, v.y, v.z)
        elseif v.__type == "Instance" then
            return {__isSerializedInstance = true, name = v.name, className = v.className}
        else
            local res = {}
            for k, val in pairs(v) do
                local numKey = tonumber(k)
                res[numKey or k] = deserializeVal(val)
            end
            return res
        end
    else
        return v
    end
end

