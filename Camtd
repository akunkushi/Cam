local function getRootFromModel(model)
    if not model then return nil end
    if model:IsA("Model") then
        if model.PrimaryPart then return model.PrimaryPart end
        if model:FindFirstChild("HumanoidRootPart") then return model.HumanoidRootPart end
    end
    if model:IsA("BasePart") then return model end
    for _, child in ipairs(model:GetDescendants()) do
        if child:IsA("BasePart") then return child end
    end
    return nil
end

local function getCFrameFromArgs(args)
    for _, v in pairs(args) do
        if typeof(v) == "CFrame" then return v end
        if typeof(v) == "Vector3" then return CFrame.new(v) end
        if type(v) == "table" then
            local cf = getCFrameFromArgs(v)
            if cf then return cf end
        end
    end
    return nil
end

local function getTowerFromArgs(args)
    for _, v in pairs(args) do
        if typeof(v) == "Instance" and v:IsA("Model") then
            return v
        elseif type(v) == "table" then
            local model = getTowerFromArgs(v)
            if model then return model end
        end
    end
    return nil
end

local function findTowerNearPosition(targetPos, excludeInstances)
    excludeInstances = excludeInstances or {}
    if not targetPos then return nil end
    if typeof(targetPos) == "CFrame" then targetPos = targetPos.Position end
    local closest, closestDist = nil, 6
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj ~= LocalPlayer.Character then
            if not excludeInstances[obj] then
                local root = getRootFromModel(obj)
                if root then
                    local dist = (root.Position - targetPos).Magnitude
                    if dist < closestDist then 
                        closestDist = dist
                        closest = obj 
                    end
                end
            end
        end
    end
    return closest
end

local function resolveTargetIndex(args, targetModel, actionPos)
    if targetModel then
        for idx, tInfo in pairs(recordedTowers) do
            if tInfo.Model and tInfo.Model == targetModel then
                return idx
            end
        end
    end
    
    local targetRoot = targetModel and getRootFromModel(targetModel)
    local targetPos = targetRoot and targetRoot.Position or (targetModel and targetModel.PrimaryPart and targetModel.PrimaryPart.Position)
    if not targetPos and actionPos then
        targetPos = (typeof(actionPos) == "CFrame") and actionPos.Position or actionPos
    end
    if not targetPos then
        local cf = getCFrameFromArgs(args)
        if cf then targetPos = cf.Position end
    end
    
    if targetPos then
        local minDist = 999999
        local bestIdx = 1
        for idx, tInfo in pairs(recordedTowers) do
            if tInfo.PositionCF then
                local dist = (tInfo.PositionCF.Position - targetPos).Magnitude
                if dist < minDist then
                    minDist = dist
                    bestIdx = idx
                end
            end
        end
        return bestIdx
    end
    
    return 1
end

-- PENCARIAN ID RUNTIME: Mengambil string ID (UUID) dari model tower di sesi game saat ini secara otomatis
local function extractRuntimeIdFromModel(model)
    if not model then return nil end
    -- Cek apakah ada atribut atau nilai string di dalam model yang menyerupai UUID
    for _, attrName in ipairs(model:GetAttributeList()) do
        local val = model:GetAttribute(attrName)
        if type(val) == "string" and #val > 15 then
            return val
        end
    end
    for _, desc in ipairs(model:GetDescendants()) do
        if desc:IsA("StringValue") and #desc.Value > 15 then
            return desc.Value
        end
    end
    -- Jika tidak ketemu lewat atribut/string value, ambil nama atau identifikasi unik yang ada di model
    return nil
end

local function rebuildArgsForPlaybackWithDynamicId(oldArgs, newModel)
    if not newModel then return oldArgs end
    
    -- Cari runtime ID dari model saat ini di sesi game berjalan
    local runtimeId = nil
    for _, attrName in ipairs(newModel:GetAttributeList()) do
        local val = newModel:GetAttribute(attrName)
        if type(val) == "string" and #val > 15 then
            runtimeId = val
            break
        end
    end
    if not runtimeId then
        for _, desc in ipairs(newModel:GetDescendants()) do
            if desc:IsA("StringValue") and #desc.Value > 15 then
                runtimeId = desc.Value
                break
            end
        end
    end

    local function recursiveProcess(tbl)
        local res = {}
        for k, v in pairs(tbl) do
            if type(v) == "table" then
                if v.__isSerializedInstance then
                    res[k] = newModel
                else
                    res[k] = recursiveProcess(v)
                end
            elseif typeof(v) == "Instance" then
                if v:IsA("Player") or v == LocalPlayer or (LocalPlayer.Character and v:IsDescendantOf(LocalPlayer.Character)) then
                    res[k] = v
                else
                    res[k] = newModel
                end
            elseif type(v) == "string" and #v > 15 and runtimeId then
                -- Timpa string ID lama dengan runtime ID dinamis dari sesi game saat ini!
                res[k] = runtimeId
            else
                res[k] = v
            end
        end
        return res
    end
    
    if type(oldArgs) == "table" then
        return recursiveProcess(oldArgs)
    else
        return {newModel}
    end
end

