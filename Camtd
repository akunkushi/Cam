    if isRecording then return end
    if isPlaying then
        isPlaying = false
        playBtn.Text = "Play: OFF"
        playBtn.BackgroundColor3 = Color3.fromRGB(50, 150, 50)
        logConsole("Playback stopped.")
        return
    end
    startPlayback()
end)

