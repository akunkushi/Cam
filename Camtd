local selectedSlot
local function refreshSlotList()
	for _, c in ipairs(slotList:GetChildren()) do
		if c:IsA("TextButton") then c:Destroy() end
	end
	local names = {}
	for n in pairs(slots) do table.insert(names, n) end
	table.sort(names)
	for _, n in ipairs(names) do
		local b = mkBtn(slotList, ("%s (%d aksi)"):format(n, #slots[n]), UDim2.new(), UDim2.new(1, -6, 0, 22),
			(n == selectedSlot) and Color3.fromRGB(80, 90, 150) or Color3.fromRGB(45, 45, 58))
		b.TextXAlignment = Enum.TextXAlignment.Left
		b.Font = Enum.Font.Gotham
		b.MouseButton1Click:Connect(function()
			selectedSlot = n
			S.playSlot = n
			saveSettings()
			nameBox.Text = n
			refreshSlotList()
			if refreshToggles then refreshToggles() end
		end)
	end
end

local function slotName()
	local n = nameBox.Text:gsub("^%s+", ""):gsub("%s+$", "")
	if n == "" then n = selectedSlot or "" end
	return n ~= "" and n or nil
end

saveBtn.MouseButton1Click:Connect(function()
	if mode == "record" then log("Stop record dulu sebelum Save.") return end
	local n = slotName()
	if not n then log("Isi nama makro dulu.") return end
	if #macro == 0 then log("Makro kosong, tidak ada yang disimpan.") return end
	slots[n] = deepcopy(macro)
	selectedSlot = n
	S.playSlot = n
	saveSlots()
	saveSettings()
	refreshSlotList()
	if refreshToggles then refreshToggles() end
	log(("SAVE '%s' (%d aksi) tersimpan permanen."):format(n, #macro))
end)

loadBtn.MouseButton1Click:Connect(function()
	if mode ~= "idle" then log("Stop record/play dulu sebelum Load.") return end
	local n = slotName()
	if not n or not slots[n] then log("Pilih makro yang tersimpan dulu.") return end
	macro = deepcopy(slots[n])
	selectedSlot = n
	S.playSlot = n
	saveCurrent()
	saveSettings()
	refreshCount()
	refreshSlotList()
	if refreshToggles then refreshToggles() end
	log(("LOAD '%s' (%d aksi) siap di-Play."):format(n, #macro))
end)

delBtn.MouseButton1Click:Connect(function()
	local n = slotName()
	if not n or not slots[n] then log("Pilih makro yang mau dihapus.") return end
	slots[n] = nil
	if selectedSlot == n then selectedSlot = nil end
	if S.playSlot == n then S.playSlot = nil saveSettings() end
	nameBox.Text = ""
	saveSlots()
	refreshSlotList()
	if refreshToggles then refreshToggles() end
	log(("HAPUS '%s'."):format(n))
end)

