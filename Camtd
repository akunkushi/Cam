local waveLbl, nextWaveScan = nil, 0
local function getWave()
	if not waveLbl or not waveLbl.Parent then
		waveLbl = nil
		if os.clock() < nextWaveScan then return nil end
		nextWaveScan = os.clock() + 5
		local pg = LP:FindFirstChild("PlayerGui")
		if not pg then return nil end
		for _, v in ipairs(pg:GetDescendants()) do
			if v:IsA("TextLabel") and v.Text:upper():match("^%s*WAVE%s*%d+%s*/%s*%d+") then
				waveLbl = v break
			end
		end
	end
	if waveLbl then
		if not guiVisible(waveLbl) then return 0 end
		return tonumber(waveLbl.Text:upper():match("WAVE%s*(%d+)"))
	end
	return nil
end

local speedPairs, nextSpeedScan = nil, 0
local function findSpeedBtn(scope, except)
	if not scope then return nil end
	for _, d in ipairs(scope:GetDescendants()) do
		if (d:IsA("TextLabel") or d:IsA("TextButton")) and d ~= except and d.Text:match("^%s*[%d%.]+%s*[xX]%s*$") then
			return d
		end
	end
end
local function buildSpeedPairs()
	speedPairs = {}
	local pg = LP:FindFirstChild("PlayerGui")
	if not pg then return end
	for _, v in ipairs(pg:GetDescendants()) do
		if v:IsA("TextLabel") then
			local t = v.Text:upper()
			if t == "ACTIVE" or t == "NORMAL" or t == "GET PASS" then
				local b = findSpeedBtn(v.Parent, v) or findSpeedBtn(v.Parent and v.Parent.Parent, v)
				if b then table.insert(speedPairs, { status = v, btn = b }) end
			end
		end
	end
end
local function detectSpeed()
	if speedPairs then
		for _, p in ipairs(speedPairs) do
			if not p.status.Parent then speedPairs = nil break end
		end
	end
	if not speedPairs or (#speedPairs == 0 and os.clock() > nextSpeedScan) then
		nextSpeedScan = os.clock() + 5
		buildSpeedPairs()
	end
	for _, p in ipairs(speedPairs) do
		if p.status.Text:upper() == "ACTIVE" then
			return tonumber(p.btn.Text:match("([%d%.]+)"))
		end
	end
	return nil
end

