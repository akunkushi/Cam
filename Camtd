local function getRootFromModel(model)
    if not model then return nil end
    if model:IsA("Model") then
        if model.PrimaryPart then return model.PrimaryPart end
        if model:FindFirstChild("HumanoidRootPart") then return model.HumanoidRootPart end
    end
    if model:IsA("BasePart") then return model end
    for _, child in ipairs(model:GetDescendants()) do
        if child:IsA("BasePart") then return child end
    end
    return nil
end

local function getCFrameFromArgs(args)
    for _, v in pairs(args) do
        if typeof(v) == "CFrame" then return v end
        if typeof(v) == "Vector3" then return CFrame.new(v) end
        if type(v) == "table" then
            local cf = getCFrameFromArgs(v)
            if cf then return cf end
        end
    end
    return nil
end

local function getInstanceFromArgs(args)
    for _, v in pairs(args) do
        if typeof(v) == "Instance" then return v end
        if type(v) == "table" then
            local inst = getInstanceFromArgs(v)
            if inst then return inst end
        end
    end
    return nil
end

local function findTowerNearPosition(targetPos, excludeInstances)
    excludeInstances = excludeInstances or {}
    if not targetPos then return nil end
    if typeof(targetPos) == "CFrame" then targetPos = targetPos.Position end
    local closest, closestDist = nil, 6
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj ~= LocalPlayer.Character then
            if not excludeInstances[obj] then
                local root = getRootFromModel(obj)
                if root then
                    local dist = (root.Position - targetPos).Magnitude
                    if dist < closestDist then 
                        closestDist = dist
                        closest = obj 
                    end
                end
            end
        end
    end
    return closest
end

-- LOGIKA BARU: Dynamic Model Binding saat Upgrade/Sell
local function resolveTargetIndex(args)
    local inst = getInstanceFromArgs(args)
    local targetModel = nil
    if inst then
        if inst:IsA("Model") then
            targetModel = inst
        else
            targetModel = inst:FindFirstAncestorOfClass("Model")
        end
    end

    -- 1. Cek apakah model ini sudah terikat sebelumnya
    if targetModel then
        for idx, tInfo in pairs(recordedTowers) do
            if tInfo.Instance == targetModel then
                return idx
            end
        end
    end

    -- 2. Cari berdasarkan posisi terdekat dan langsung ikat secara otomatis (Dynamic Binding)
    local targetPos = nil
    if targetModel then
        local root = getRootFromModel(targetModel)
        if root then targetPos = root.Position end
    end
    
    if not targetPos then
        local cf = getCFrameFromArgs(args)
        if cf then targetPos = cf.Position end
    end

    if targetPos then
        local minDist = 999999
        local bestIdx = 1
        for idx, tInfo in pairs(recordedTowers) do
            if tInfo.PositionCF then
                local d = (tInfo.PositionCF.Position - targetPos).Magnitude
                if d < minDist then
                    minDist = d
                    bestIdx = idx
                end
            end
        end
        
        -- Ikat model instance ke index terbaik agar ke depannya langsung dikenali secara akurat
        if targetModel and recordedTowers[bestIdx] then
            recordedTowers[bestIdx].Instance = targetModel
        end
        return bestIdx
    end
    
    return 1
end

-- Hook Remote
if not getgenv().MacroHookedTD then
    getgenv().MacroHookedTD = true
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        
        if isRecording and (method == "FireServer" or method == "InvokeServer") then
            local rName = self.Name
            if rName == "TowerAdd" or rName == "TowerUpgrade" or rName == "TowerSell" then
                task.spawn(function()
                    pcall(function()
                        local timeStamp = tick() - recordStartTime
                        if rName == "TowerAdd" then
                            towerCounter = towerCounter + 1
                            local currentIdx = towerCounter
                            local cf = getCFrameFromArgs(args)
                            
                            recordedTowers[currentIdx] = { Index = currentIdx, PositionCF = cf }
                            table.insert(recordedData, {
                                Type = "ADD", Time = timeStamp, Remote = self, Method = method,
                                Args = serializeVal(args), TowerIndex = currentIdx, PositionCF = cf
                            })
                            logConsole(string.format("[Rec] TowerAdd #%d", currentIdx))
                            
                            -- Cari model tower di Workspace secara langsung
                            task.spawn(function()
                                local timer = 0
                                local model = nil
                                while timer < 3 do
                                    task.wait(0.1)
                                    timer = timer + 0.1
                                    local excludeInstances = {}
                                    for k, t in pairs(recordedTowers) do
                                        if k ~= currentIdx and t.Instance then
                                            excludeInstances[t.Instance] = true
                                        end
                                    end
                                    model = findTowerNearPosition(cf, excludeInstances)
                                    if model then break end
                                end
                                if model and recordedTowers[currentIdx] then
                                    recordedTowers[currentIdx].Instance = model
                                end
                            end)
                        elseif rName == "TowerUpgrade" or rName == "TowerSell" then
                            local targetIdx = resolveTargetIndex(args)
                            table.insert(recordedData, {
                                Type = (rName == "TowerUpgrade" and "UPGRADE" or "SELL"),
                                Time = timeStamp, Remote = self, Method = method,
                                Args = serializeVal(args), TargetIndex = targetIdx
                            })
                            logConsole(string.format("[Rec] %s -> Tower #%d", rName, targetIdx))
                        end
                    end)
                end)
            end
        end
        return oldNamecall(self, ...)
    end))
end

