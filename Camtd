local function getRootFromModel(model)
    if not model then return nil end
    if model:IsA("Model") then
        if model.PrimaryPart then return model.PrimaryPart end
        if model:FindFirstChild("HumanoidRootPart") then return model.HumanoidRootPart end
    end
    if model:IsA("BasePart") then return model end
    for _, child in ipairs(model:GetDescendants()) do
        if child:IsA("BasePart") then return child end
    end
    return nil
end

local function getCFrameFromArgs(args)
    for _, v in pairs(args) do
        if typeof(v) == "CFrame" then return v end
        if typeof(v) == "Vector3" then return CFrame.new(v) end
        if type(v) == "table" then
            local cf = getCFrameFromArgs(v)
            if cf then return cf end
        end
    end
    return nil
end

local function getTowerFromArgs(args)
    for _, v in pairs(args) do
        if typeof(v) == "Instance" and (v:IsA("Model") or v:IsA("BasePart")) then
            if v ~= LocalPlayer.Character and not v:IsDescendantOf(LocalPlayer.Character) then
                if v:IsA("BasePart") then return v.Parent end
                return v
            end
        elseif type(v) == "table" then
            local found = getTowerFromArgs(v)
            if found then return found end
        end
    end
    return nil
end

local function extractAllIDsFromModel(inst)
    if not inst or not inst:IsA("Instance") then return {} end
    local ids = {inst.Name}
    for k, v in pairs(inst:GetAttributes()) do
        if type(v) == "string" or type(v) == "number" then table.insert(ids, tostring(v)) end
    end
    for _, child in ipairs(inst:GetDescendants()) do
        if child:IsA("ValueBase") and child.Value then table.insert(ids, tostring(child.Value)) end
    end
    return ids
end

local function getPrimaryID(inst)
    if not inst or not inst:IsA("Instance") then return nil end
    for k, v in pairs(inst:GetAttributes()) do
        if k:lower():find("id") or k:lower():find("uuid") then return tostring(v) end
    end
    return inst.Name
end

local function findTowerNearPosition(targetPos, excludeInstances)
    excludeInstances = excludeInstances or {}
    if not targetPos then return nil end
    if typeof(targetPos) == "CFrame" then targetPos = targetPos.Position end
    local closest, closestDist = nil, 10 -- Radius deteksi diset ke 10 stud
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj ~= LocalPlayer.Character then
            if not excludeInstances[obj] then
                local root = getRootFromModel(obj)
                if root then
                    local dist = (root.Position - targetPos).Magnitude
                    if dist < closestDist then 
                        closestDist = dist
                        closest = obj 
                    end
                end
            end
        end
    end
    return closest
end

local function resolveTargetIndex(args, targetModel, actionPos)
    if targetModel and instanceToTowerIndex[targetModel] then
        return instanceToTowerIndex[targetModel]
    end

    local function searchIDInTable(tbl)
        for _, v in pairs(tbl) do
            local vStr = tostring(v)
            for idx, tInfo in pairs(recordedTowers) do
                if tInfo.IDs then
                    for _, id in ipairs(tInfo.IDs) do
                        if tostring(id) == vStr and #vStr > 2 then
                            return idx
                        end
                    end
                end
            end
            if type(v) == "table" then
                local found = searchIDInTable(v)
                if found then return found end
            end
        end
        return nil
    end
    
    local matchedById = searchIDInTable(args)
    if matchedById then return matchedById end
    
    local targetRoot = targetModel and getRootFromModel(targetModel)
    local targetPos = targetRoot and targetRoot.Position or (targetModel and targetModel.PrimaryPart and targetModel.PrimaryPart.Position)
    if not targetPos and actionPos then
        targetPos = (typeof(actionPos) == "CFrame") and actionPos.Position or actionPos
    end
    if not targetPos then
        local cf = getCFrameFromArgs(args)
        if cf then targetPos = cf.Position end
    end
    
    if targetPos then
        local minDist = 999999
        local bestIdx = 1
        for idx, tInfo in pairs(recordedTowers) do
            if tInfo.PositionCF then
                local dist = (tInfo.PositionCF.Position - targetPos).Magnitude
                if dist < minDist then
                    minDist = dist
                    bestIdx = idx
                end
            end
        end
        return bestIdx
    end
    
    return 1
end

local function rebuildArgsForPlayback(oldArgs, recordedIDsList, newModel, newMatchIDs)
    if not newModel then return oldArgs end
    local newPrimaryID = getPrimaryID(newModel)
    local targetRoot = getRootFromModel(newModel)
    
    local function processTable(tbl)
        local res = {}
        for k, v in pairs(tbl) do
            if type(v) == "table" and v.__isSerializedInstance then
                res[k] = newModel
            elseif typeof(v) == "Instance" then
                if v:IsA("Player") or v == LocalPlayer or (LocalPlayer.Character and v:IsDescendantOf(LocalPlayer.Character)) then
                    res[k] = v
                else
                    res[k] = newModel
                end
            elseif typeof(v) == "CFrame" and targetRoot then
                res[k] = targetRoot.CFrame
            elseif typeof(v) == "Vector3" and targetRoot then
                res[k] = targetRoot.Position
            elseif type(v) == "string" or type(v) == "number" then
                local strVal = tostring(v)
                if type(v) == "number" and v < 10 then
                    res[k] = v
                else
                    local replaced = false
                    if recordedIDsList and #recordedIDsList > 0 then
                        for i, oldID in ipairs(recordedIDsList) do
                            if strVal == tostring(oldID) and #strVal > 2 then
                                if newMatchIDs and newMatchIDs[i] then
                                    res[k] = newMatchIDs[i]
                                else
                                    res[k] = newPrimaryID or newModel.Name
                                end
                                replaced = true
                                break
                            end
                        end
                    end
                    if not replaced then
                        res[k] = v
                    end
                end
            elseif type(v) == "table" then
                res[k] = processTable(v)
            else
                res[k] = v
            end
        end
        return res
    end
    return processTable(oldArgs)
end

if not getgenv().MacroHookedTD then
    getgenv().MacroHookedTD = true
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        
        if isRecording and (method == "FireServer" or method == "InvokeServer") then
            local rName = self.Name
            if rName == "TowerAdd" or rName == "TowerUpgrade" or rName == "TowerSell" then
                task.spawn(function()
                    pcall(function()
                        local timeStamp = tick() - recordStartTime
                        local cashBefore = getPlayerCash()
                        
                        if rName == "TowerAdd" then
                            towerCounter = towerCounter + 1
                            local currentIdx = towerCounter
                            local cf = getCFrameFromArgs(args)
                            
                            local newlySpawnedModel = nil
                            local checkTimer = 0
                            repeat
                                task.wait(0.1)
                                checkTimer = checkTimer + 0.1
                                newlySpawnedModel = findTowerNearPosition(cf)
                            until newlySpawnedModel or checkTimer >= 1.0
                            
                            local cashAfter = getPlayerCash()
                            local cost = cashBefore - cashAfter
                            
                            if not cf and newlySpawnedModel then
                                cf = newlySpawnedModel:GetPivot()
                            end
                            
                            recordedTowers[currentIdx] = { 
                                Index = currentIdx, 
                                PositionCF = cf, 
                                IDs = newlySpawnedModel and extractAllIDsFromModel(newlySpawnedModel) or {},
                                Model = newlySpawnedModel
                            }
                            
                            if newlySpawnedModel then
                                instanceToTowerIndex[newlySpawnedModel] = currentIdx
                            end
                            
                            local actionEntry = {
                                Type = "ADD", Time = timeStamp, Remote = self, Method = method,
                                Args = serializeVal(args), TowerIndex = currentIdx, PositionCF = cf, CashCost = 150,
                                TowerIDs = recordedTowers[currentIdx].IDs
                            }
                            table.insert(recordedData, actionEntry)
                            local entryIndex = #recordedData
                            
                            if (cost > 0 and cost < 100000) or newlySpawnedModel then
                                if cost > 0 and cost < 100000 then actionEntry.CashCost = cost end
                                logConsole(string.format("[Rec] TowerAdd #%d Sukses (Cost: %d)", currentIdx, actionEntry.CashCost))
                            else
                                table.remove(recordedData, entryIndex)
                                recordedTowers[currentIdx] = nil
                                if newlySpawnedModel then instanceToTowerIndex[newlySpawnedModel] = nil end
                                towerCounter = towerCounter - 1
                                logConsole("[Rec] TowerAdd Gagal/Dibatalkan (Dihapus dari rekaman)")
                            end
                            
                        elseif rName == "TowerUpgrade" or rName == "TowerSell" then
                            local targetModel = getTowerFromArgs(args) or lastClickedTower
                            local actionPos = targetModel and targetModel:GetPivot() or getCFrameFromArgs(args)
                            local targetIdx = resolveTargetIndex(args, targetModel, actionPos)
                            local actionType = (rName == "TowerUpgrade" and "UPGRADE" or "SELL")
                            local targetIDs = recordedTowers[targetIdx] and recordedTowers[targetIdx].IDs or {}
                            
                            local actionEntry = {
                                Type = actionType, Time = timeStamp, Remote = self, Method = method,
                                Args = serializeVal(args), TargetIndex = targetIdx, CashCost = 150,
                                TowerIDs = targetIDs, PositionCF = actionPos
                            }
                            table.insert(recordedData, actionEntry)
                            local entryIndex = #recordedData
                            
                            local isSuccess = false
                            local checkTimer = 0
                            repeat
                                task.wait(0.1)
                                checkTimer = checkTimer + 0.1
                                local cashAfter = getPlayerCash()
                                local cost = cashBefore - cashAfter
                                
                                if rName == "TowerUpgrade" and cost > 0 and cost < 100000 then
                                    isSuccess = true
                                    actionEntry.CashCost = cost
                                    break
                                elseif rName == "TowerSell" and cost < 0 then
                                    isSuccess = true
                                    actionEntry.CashCost = math.abs(cost)
                                    break
                                end
                            until checkTimer >= 1.0
                            
                            if isSuccess then
                                logConsole(string.format("[Rec] %s -> Tower #%d Sukses", actionType, targetIdx))
                            else
                                table.remove(recordedData, entryIndex)
                                logConsole(string.format("[Rec] %s Gagal/Dibatalkan (Dihapus dari rekaman)", actionType))
                            end
                        end
                    end)
                end)
            end
        end
        return oldNamecall(self, ...)
    end))
end

