    getgenv().MacroHookedTD = true
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        
        if isRecording and (method == "FireServer" or method == "InvokeServer") then
            local rName = self.Name
            if rName == "TowerAdd" or rName == "TowerUpgrade" or rName == "TowerSell" then
                task.spawn(function()
                    pcall(function()
                        local timeStamp = tick() - recordStartTime
                        local cashBefore = getPlayerCash()
                        
                        if rName == "TowerAdd" then
                            towerCounter = towerCounter + 1
                            local currentIdx = towerCounter
                            local cf = getCFrameFromArgs(args)
                            
                            task.wait(0.4)
                            local cashAfter = getPlayerCash()
                            local cost = cashBefore - cashAfter
                            local newlySpawnedModel = findTowerNearPosition(cf)
                            
                            if not cf and newlySpawnedModel then
                                cf = newlySpawnedModel:GetPivot()
                            end
                            
                            recordedTowers[currentIdx] = { 
                                Index = currentIdx, 
                                PositionCF = cf, 
                                Model = newlySpawnedModel
                            }
                            
                            local actionEntry = {
                                Type = "ADD", Time = timeStamp, Remote = self, Method = method,
                                Args = serializeVal(args), TowerIndex = currentIdx, PositionCF = cf, CashCost = 150
                            }
                            table.insert(recordedData, actionEntry)
                            local entryIndex = #recordedData
                            
                            if (cost > 0 and cost < 100000) or newlySpawnedModel then
                                if cost > 0 and cost < 100000 then actionEntry.CashCost = cost end
                                logConsole(string.format("[Rec] TowerAdd #%d Sukses (Cost: %d)", currentIdx, actionEntry.CashCost))
                            else
                                table.remove(recordedData, entryIndex)
                                recordedTowers[currentIdx] = nil
                                towerCounter = towerCounter - 1
                                logConsole("[Rec] TowerAdd Gagal/Dibatalkan (Dihapus dari rekaman)")
                            end
                            
                        elseif rName == "TowerUpgrade" or rName == "TowerSell" then
                            local targetModel = getTowerFromArgs(args)
                            local targetIdx = resolveTargetIndex(args, targetModel, nil)
                            local actionType = (rName == "TowerUpgrade" and "UPGRADE" or "SELL")
                            
                            local actionEntry = {
                                Type = actionType, Time = timeStamp, Remote = self, Method = method,
                                Args = serializeVal(args), TargetIndex = targetIdx, CashCost = 150,
                                PositionCF = targetModel and targetModel:GetPivot() or nil
                            }
                            table.insert(recordedData, actionEntry)
                            local entryIndex = #recordedData
                            
                            task.wait(0.4)
                            local cashAfter = getPlayerCash()
                            local cost = cashBefore - cashAfter
                            
                            local isSuccess = false
                            if rName == "TowerUpgrade" and cost > 0 and cost < 100000 then
                                isSuccess = true
                                actionEntry.CashCost = cost
                            elseif rName == "TowerSell" and cost < 0 then
                                isSuccess = true
                                actionEntry.CashCost = math.abs(cost)
                            end
                            
                            if isSuccess then
                                logConsole(string.format("[Rec] %s -> Tower #%d Sukses", rName, targetIdx))
                            else
                                table.remove(recordedData, entryIndex)
                                logConsole(string.format("[Rec] %s Gagal/Dibatalkan (Dihapus dari rekaman)", rName))
                            end
                        end
                    end)
                end)
            end
        end
        return oldNamecall(self, ...)
    end))
end

