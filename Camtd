function startPlayback()
    if #recordedData == 0 then
        logConsole("Data rekaman kosong!")
        return
    end
    
    isPlaying = true
    playBtn.Text = "Playing..."
    playBtn.BackgroundColor3 = Color3.fromRGB(210, 140, 20)
    logConsole("PLAYBACK STARTED...")
    
    task.spawn(function()
        local playbackStart = tick()
        local sessionTowers = {}
        
        for index, action in ipairs(recordedData) do
            if not isPlaying then break end
            local waitTime = action.Time - (tick() - playbackStart)
            if waitTime > 0 then task.wait(waitTime) end
            if not isPlaying then break end
            
            pcall(function()
                local remoteObj = action.Remote or ReplicatedStorage:FindFirstChild(action.RemoteName, true)
                local realArgs = deserializeVal(action.Args)
                
                if action.Type == "ADD" or action.Type == "UPGRADE" then
                    local timeout = 0
                    while isPlaying and getPlayerCash() < 50 and timeout < 30 do
                        logConsole(string.format("[%d/%d] Menunggu Cash Cukup...", index, #recordedData))
                        task.wait(1)
                        timeout = timeout + 1
                    end
                end

                if action.Type == "ADD" then
                    local beforeSnapshot = {}
                    for _, v in ipairs(Workspace:GetDescendants()) do
                        if v:IsA("Model") then beforeSnapshot[v] = true end
                    end
                    
                    if action.Method == "InvokeServer" then remoteObj:InvokeServer(unpack(realArgs))
                    else remoteObj:FireServer(unpack(realArgs)) end
                    
                    local newlySpawnedModel = nil
                    local timer = 0
                    repeat
                        task.wait(0.1)
                        timer = timer + 0.1
                        for _, v in ipairs(Workspace:GetDescendants()) do
                            if v:IsA("Model") and not beforeSnapshot[v] and v ~= LocalPlayer.Character then
                                if getRootFromModel(v) then
                                    newlySpawnedModel = v; break
                                end
                            end
                        end
                    until newlySpawnedModel or timer >= 3.5
                    
                    if not newlySpawnedModel and action.PositionCF then
                        local excludeInstances = {}
                        for _, t in pairs(sessionTowers) do excludeInstances[t] = true end
                        newlySpawnedModel = findTowerNearPosition(action.PositionCF, excludeInstances)
                    end
                    
                    if newlySpawnedModel then
                        sessionTowers[action.TowerIndex] = newlySpawnedModel
                        logConsole(string.format("[%d/%d] PLACE Tower #%d OK", index, #recordedData, action.TowerIndex))
                    else
                        logConsole(string.format("[%d/%d] PLACE Tower #%d FAIL", index, #recordedData, action.TowerIndex))
                    end
                elseif action.Type == "UPGRADE" or action.Type == "SELL" then
                    local targetIdx = action.TargetIndex or 1
                    local currentModel = sessionTowers[targetIdx]
                    
                    if not currentModel and recordedTowers[targetIdx] and recordedTowers[targetIdx].PositionCF then
                        local excludeInstances = {}
                        for k, t in pairs(sessionTowers) do 
                            if k ~= targetIdx then excludeInstances[t] = true end 
                        end
                        currentModel = findTowerNearPosition(recordedTowers[targetIdx].PositionCF, excludeInstances)
                    end
                    
                    if currentModel then
                        task.wait(0.4)
                        local targetRoot = getRootFromModel(currentModel)
                        if targetRoot then
                            for k, v in pairs(realArgs) do
                                if typeof(v) == "CFrame" then
                                    realArgs[k] = targetRoot.CFrame
                                elseif typeof(v) == "Vector3" then
                                    realArgs[k] = targetRoot.Position
                                elseif typeof(v) == "Instance" and v:IsA("Model") then
                                    realArgs[k] = currentModel
                                end
                            end
                        end
                        
                        if action.Method == "InvokeServer" then remoteObj:InvokeServer(unpack(realArgs))
                        else remoteObj:FireServer(unpack(realArgs)) end
                        logConsole(string.format("[%d/%d] %s Tower #%d DONE", index, #recordedData, action.Type, targetIdx))
                    else
                        logConsole(string.format("[%d/%d] %s Tower #%d FAIL", index, #recordedData, action.Type, targetIdx))
                    end
                end
            end)
        end
        
        isPlaying = false
        playBtn.Text = "Play: OFF"
        playBtn.BackgroundColor3 = Color3.fromRGB(50, 150, 50)
        logConsole("=== PLAYBACK FINISHED ===")
    end)
end

