------------------------------------------------------------------ AUTO PICKUP (karakter jalan ke item)
local openDrops = {}
local assigned = {}
local recentAdds = {}
local pickStat = { ok = 0, fail = 0 }
local itemConns, itemConnected = {}, {}
local pickLabel, wsConn

local function posOf(inst)
	if inst:IsA("BasePart") then return inst.Position end
	if inst:IsA("Model") then return getPos(inst) end
end

local function isIgnored(inst)
	local cam = workspace.CurrentCamera
	if cam and inst:IsDescendantOf(cam) then return true end
	for _, pl in ipairs(Players:GetPlayers()) do
		local c = pl.Character
		if c and inst:IsDescendantOf(c) then return true end
	end
	local tf = getFolder()
	if tf and inst:IsDescendantOf(tf) then return true end
	return false
end

local function onWsAdded(inst)
	if not alive then return end
	if inst:IsA("BasePart") or inst:IsA("Model") then
		recentAdds[#recentAdds + 1] = { inst = inst, t = os.clock() }
		if #recentAdds > 400 then table.remove(recentAdds, 1) end
	end
end

local function findRecent(t)
	for i = #recentAdds, 1, -1 do
		local e = recentAdds[i]
		if e.t < t.born - 3 then break end
		local inst = e.inst
		if e.t <= t.born + 4 and inst.Parent and inst.Name == t.name
			and not assigned[inst] and not isIgnored(inst) then
			return inst
		end
	end
end

local function scanWorkspace(t)
	local cands = {}
	local list = workspace:GetDescendants()
	for i, d in ipairs(list) do
		local cand
		if d.Name == t.name and (d:IsA("BasePart") or d:IsA("Model")) then
			cand = d
		elseif d:IsA("TextLabel") and d.Text == t.name then
			local bb = d:FindFirstAncestorWhichIsA("BillboardGui")
			local ad = bb and (bb.Adornee or bb.Parent)
			if ad and (ad:IsA("BasePart") or ad:IsA("Model")) then cand = ad end
		end
		if cand and not assigned[cand] and not isIgnored(cand) and posOf(cand) then
			cands[#cands + 1] = cand
			if #cands >= 6 then break end
		end
		if i % 4000 == 0 then task.wait() end
	end
	for _, c in ipairs(cands) do
		local ok, tt = pcall(function() return c:FindFirstChildWhichIsA("TouchTransmitter", true) end)
		if ok and tt then return c end
	end
	return cands[1]
end

local function markFail(t, why)
	if t.failed then return end
	t.failed = true
	pickStat.fail += 1
	log(("PICKUP GAGAL: %s (%s)"):format(t.name, why))
end

local function onItemEvent(tag, id, name)
	if not alive or type(id) ~= "string" then return end
	if tag == "Drop" then
		if not openDrops[id] then
			openDrops[id] = { name = tostring(name), born = os.clock(), n = 0 }
		end
	elseif tag == "Taken" then
		local t = openDrops[id]
		if t then
			openDrops[id] = nil
			if t.inst then assigned[t.inst] = nil end
			if t.n > 0 and not t.failed then
				pickStat.ok += 1
				log(("PICKUP OK: %s (%d percobaan)"):format(t.name, t.n))
			end
		end
	end
end

local function connectItem(ev)
	if itemConnected[ev] or ev.Name ~= "ItemDrop" or not ev:IsA("RemoteEvent") then return end
	itemConnected[ev] = true
	local ok, c = pcall(function()
		return ev.OnClientEvent:Connect(function(...) pcall(onItemEvent, ...) end)
	end)
	if ok and c then table.insert(itemConns, c) end
end

local function getHum()
	local c = LP.Character
	local h = c and c:FindFirstChildOfClass("Humanoid")
	local r = c and c:FindFirstChild("HumanoidRootPart")
	if h and r and h.Health > 0 then return h, r end
end

local function followPath(h, r, p, isDone)
	local ok, path = pcall(function()
		return PathfindingService:CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = true })
	end)
	if not ok or not path then return end
	local okc = pcall(function() path:ComputeAsync(r.Position, p) end)
	if not okc or path.Status ~= Enum.PathStatus.Success then return end
	for _, wp in ipairs(path:GetWaypoints()) do
		if not alive or not S.autoPickup or isDone() then return end
		if wp.Action == Enum.PathWaypointAction.Jump then h.Jump = true end
		local fin = false
		local c = h.MoveToFinished:Connect(function() fin = true end)
		h:MoveTo(wp.Position)
		local t = os.clock()
		while not fin and os.clock() - t < 2 and alive and not isDone() do task.wait(0.05) end
		c:Disconnect()
	end
end

local function walkTo(getTarget, isDone, timeout)
	local t0 = os.clock()
	local h, r = getHum()
	if not h then return false end
	local lastPos, lastMove = r.Position, os.clock()
	local pathTried = 0
	while alive and S.autoPickup and os.clock() - t0 < timeout do
		if isDone() then return true end
		h, r = getHum()
		if not h then return false end
		local p = getTarget()
		if not p then return false end
		local dx, dz = p.X - r.Position.X, p.Z - r.Position.Z
		if math.sqrt(dx * dx + dz * dz) < PK.REACH and math.abs(p.Y - r.Position.Y) < 10 then return true end
		h:MoveTo(p)
		if (r.Position - lastPos).Magnitude > 0.8 then
			lastPos, lastMove = r.Position, os.clock()
		elseif os.clock() - lastMove > 1.2 then
			h.Jump = true
			if os.clock() - lastMove > 2.5 and pathTried < 3 then
				pathTried += 1
				followPath(h, r, p, isDone)
				lastPos, lastMove = r.Position, os.clock()
			end
		end
		task.wait(0.15)
	end
	return false
end

local function resolveItem(t)
	if t.inst and t.inst.Parent then return t.inst end
	if t.inst then assigned[t.inst] = nil t.inst = nil end
	local i = findRecent(t)
	if not i and not t.scanned and os.clock() - t.born > 1.2 then
		t.scanned = true
		i = scanWorkspace(t)
	end
	if i then
		t.inst = i
		assigned[i] = true
		local p = posOf(i)
		log(("Item ketemu: %s @ %s"):format(t.name, i:GetFullName():sub(-40)))
		if not p then t.inst = nil assigned[i] = nil end
	end
	return t.inst
end

task.spawn(function()
	while alive do
		task.wait(0.3)
		local now = os.clock()

		local ids = {}
		for id in pairs(openDrops) do ids[#ids + 1] = id end

		for _, id in ipairs(ids) do
			local t = openDrops[id]
			if t and now - t.born > PK.MAX_AGE then
				openDrops[id] = nil
				if t.inst then assigned[t.inst] = nil end
				if t.n > 0 then markFail(t, "kadaluarsa") end
			end
		end

		if S.autoPickup then
			local h, r = getHum()
			if h then
				local bestId, bestT, bestD
				ids = {}
				for id in pairs(openDrops) do ids[#ids + 1] = id end
				for _, id in ipairs(ids) do
					local t = openDrops[id]
					if t and not t.failed then
						local inst = resolveItem(t)
						if inst then
							local p = posOf(inst)
							if p then
								local d = (p - r.Position).Magnitude
								if not bestD or d < bestD then bestId, bestT, bestD = id, t, d end
							end
						elseif os.clock() - t.born > PK.FIND_TIMEOUT then
							markFail(t, "item fisik tidak ketemu")
						end
					end
				end

				if bestT and openDrops[bestId] == bestT then
					local t, id = bestT, bestId
					t.n += 1
					log(("AUTO PICKUP: jalan ke %s (%d studs)"):format(t.name, bestD))
					if t.n > 1 then
						local h2, r2p = getHum()
						if h2 then
							h2.Jump = true
							h2:MoveTo(r2p.Position + Vector3.new(4, 0, 0))
							task.wait(0.6)
						end
					end
					walkTo(function()
						local i = t.inst
						return i and i.Parent and posOf(i) or nil
					end, function() return openDrops[id] ~= t end, PK.WALK_TIMEOUT)

					local w = os.clock()
					while alive and openDrops[id] == t and os.clock() - w < 1.5 do task.wait(0.1) end
					if openDrops[id] == t and t.n >= PK.MAX_TRY then
						markFail(t, "tidak terclaim setelah " .. t.n .. " percobaan")
					end
				end
			end
		end
	end
end)

task.spawn(function()
	while alive do
		task.wait(0.5)
		local waiting = 0
		for _, t in pairs(openDrops) do
			if not t.failed then waiting += 1 end
		end
		if pickLabel then
			pickLabel.Text = ("Pickup: ok %d | gagal %d | menunggu %d"):format(pickStat.ok, pickStat.fail, waiting)
		end
	end
end)

