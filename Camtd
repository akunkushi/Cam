------------------------------------------------------------------ AUTO PLAY (rejoin)
local function startAutoPlay()
	task.spawn(function()
		log("AUTO PLAY: menunggu game siap...")
		local t = os.clock()
		while alive and S.autoPlay and not remoteByName("RequestPlacement") and os.clock() - t < 90 do
			task.wait(1)
		end
		if not (alive and S.autoPlay) then return end
		if not remoteByName("RequestPlacement") then
			log("AUTO PLAY batal: remote place tidak ketemu (bukan di match?)")
			return
		end
		t = os.clock()
		while alive and not LP.Character and os.clock() - t < 15 do task.wait(0.5) end
		t = os.clock()
		while alive and getCash() == nil and os.clock() - t < 20 do task.wait(0.5) end
		task.wait(CFG.AUTOPLAY_DELAY)
		if not (alive and S.autoPlay) or mode ~= "idle" then return end

		local m, src
		if S.playSlot and slots[S.playSlot] then
			m, src = deepcopy(slots[S.playSlot]), "'" .. S.playSlot .. "'"
		else
			m, src = macro, "makro terakhir"
		end
		if not m or #m == 0 then
			log("AUTO PLAY batal: belum ada makro dipilih / kosong.")
			return
		end
		macro = m
		refreshCount()
		mode = "play"
		refreshUI()
		log("AUTO PLAY: menjalankan " .. src)
		playMacro()
	end)
end

