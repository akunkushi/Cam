local function isGuid(s)
	return type(s) == "string" and s:match("^%x+%-%x+%-%x+%-%x+%-%x+$") ~= nil
end
local function fmt(n) return n and tostring(math.floor(n)) or "?" end
local function r2(x) return math.floor(x * 100 + 0.5) / 100 end
local function stamp(e, tw, tt, tg)
	if e then e.w, e.t, e.g = tw, r2(math.max(0, tt)), r2(math.max(0, tg)) end
	return e
end

