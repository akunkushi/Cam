function loadMacroFromFile(mName)
    local fileName = FOLDER_NAME .. "/" .. mName .. ".json"
    if not isfile or not isfile(fileName) then
        logConsole("File " .. mName .. " tidak ditemukan!")
        return false
    end
    
    local success, res = pcall(function()
        local content = readfile(fileName)
        local data = HttpService:JSONDecode(content)
        
        recordedData = {}
        recordedTowers = {}
        
        for _, act in ipairs(data.Record) do
            local remoteObj = ReplicatedStorage:FindFirstChild(act.RemoteName, true)
            table.insert(recordedData, {
                Type = act.Type, Time = act.Time, Remote = remoteObj or ReplicatedStorage,
                RemoteName = act.RemoteName, Method = act.Method, Args = deserializeVal(act.Args),
                TowerIndex = act.TowerIndex, TargetIndex = act.TargetIndex,
                PositionCF = act.PositionCF and deserializeVal(act.PositionCF) or nil
            })
        end
        
        for idxStr, tInfo in pairs(data.Towers) do
            local idx = tonumber(idxStr)
            recordedTowers[idx] = { Index = tInfo.Index, PositionCF = tInfo.PositionCF and serializeVal(tInfo.PositionCF) or nil }
        end
        return true
    end)
    
    if success then
        logConsole("Berhasil Load: " .. mName .. " (" .. #recordedData .. " aksi)")
        return true
    else
        logConsole("Gagal membaca file makro!")
        return false
    end
end

