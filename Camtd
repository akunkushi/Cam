function startPlayback()
    if #recordedData == 0 then
        logConsole("Data rekaman kosong!")
        return
    end
    
    isPlaying = true
    playBtn.Text = "Playing..."
    playBtn.BackgroundColor3 = Color3.fromRGB(210, 140, 20)
    logConsole("PLAYBACK STARTED (Speed: " .. speedNames[currentSpeedIndex] .. " - Dynamic UUID Fix)...")
    
    applyGameSpeed(selectedSpeed)
    
    task.spawn(function()
        local playbackStart = tick()
        local sessionTowers = {}
        
        for index, action in ipairs(recordedData) do
            if not isPlaying then break end
            local waitTime = (action.Time - (tick() - playbackStart)) / selectedSpeed
            if waitTime > 0 then task.wait(waitTime) end
            if not isPlaying then break end
            
            pcall(function()
                local remoteObj = action.Remote or ReplicatedStorage:FindFirstChild(action.RemoteName, true)
                local realArgs = deserializeVal(action.Args)
                local requiredCost = action.CashCost or 100

                if action.Type == "ADD" then
                    local newlySpawnedModel = nil
                    local hasFired = false
                    
                    repeat
                        while isPlaying and getPlayerCash() < requiredCost do
                            logConsole(string.format("[%d/%d] Menunggu Cash Place (Butuh: %d | Cash: %d)...", index, #recordedData, requiredCost, getPlayerCash()))
                            task.wait(1 / selectedSpeed)
                        end
                        if not isPlaying then return end

                        local beforeSnapshot = {}
                        for _, v in ipairs(Workspace:GetDescendants()) do
                            if v:IsA("Model") then beforeSnapshot[v] = true end
                        end
                        
                        if not hasFired then
                            if action.Method == "InvokeServer" then remoteObj:InvokeServer(unpack(realArgs))
                            else remoteObj:FireServer(unpack(realArgs)) end
                            hasFired = true
                            task.wait(0.3 / selectedSpeed)
                        end
                        
                        local timer = 0
                        repeat
                            task.wait(0.1 / selectedSpeed)
                            timer = timer + (0.1 / selectedSpeed)
                            for _, v in ipairs(Workspace:GetDescendants()) do
                                if v:IsA("Model") and not beforeSnapshot[v] and v ~= LocalPlayer.Character then
                                    if getRootFromModel(v) then
                                        newlySpawnedModel = v; break
                                    end
                                end
                            end
                        until newlySpawnedModel or timer >= (2.0 / selectedSpeed)
                        
                        if not newlySpawnedModel and action.PositionCF then
                            local excludeInstances = {}
                            for _, t in pairs(sessionTowers) do excludeInstances[t] = true end
                            newlySpawnedModel = findTowerNearPosition(action.PositionCF, excludeInstances)
                        end
                        
                        if not newlySpawnedModel then
                            logConsole(string.format("[%d/%d] PLACE Tower #%d Menunggu Model...", index, #recordedData, action.TowerIndex or action.TargetIndex))
                            task.wait(0.5 / selectedSpeed)
                        end
                    until newlySpawnedModel or not isPlaying

                    if newlySpawnedModel then
                        local tIdx = action.TowerIndex or action.TargetIndex or 1
                        sessionTowers[tIdx] = newlySpawnedModel
                        task.wait(0.3)
                        logConsole(string.format("[%d/%d] PLACE Tower #%d OK", index, #recordedData, tIdx))
                    end

                elseif action.Type == "UPGRADE" or action.Type == "SELL" then
                    local targetIdx = action.TargetIndex or action.TowerIndex or 1
                    
                    local successAction = false
                    local retryCount = 0
                    repeat
                        while isPlaying and getPlayerCash() < requiredCost do
                            logConsole(string.format("[%d/%d] Menunggu Cash %s (Butuh: %d | Cash: %d)...", index, #recordedData, action.Type, requiredCost, getPlayerCash()))
                            task.wait(1 / selectedSpeed)
                        end
                        if not isPlaying then return end

                        local currentModel = sessionTowers[targetIdx]
                        if not currentModel or not currentModel.Parent then
                            if recordedTowers[targetIdx] and recordedTowers[targetIdx].PositionCF then
                                currentModel = findTowerNearPosition(recordedTowers[targetIdx].PositionCF)
                            elseif action.PositionCF then
                                currentModel = findTowerNearPosition(action.PositionCF)
                            else
                                local cfFromArgs = getCFrameFromArgs(realArgs)
                                if cfFromArgs then
                                    currentModel = findTowerNearPosition(cfFromArgs)
                                end
                            end
                        end
                        
                        if currentModel then
                            task.wait(0.2 / selectedSpeed)
                            local cashBeforePlay = getPlayerCash()
                            -- Mengganti ID string lama dengan ID runtime aktif dari sesi saat ini secara otomatis
                            local playArgs = rebuildArgsForPlaybackWithDynamicId(realArgs, currentModel)
                            
                            pcall(function()
                                if action.Method == "InvokeServer" then 
                                    remoteObj:InvokeServer(unpack(playArgs))
                                else 
                                    remoteObj:FireServer(unpack(playArgs)) 
                                end
                            end)
                            
                            task.wait(0.5 / selectedSpeed)
                            local cashAfterPlay = getPlayerCash()
                            
                            if action.Type == "UPGRADE" and cashBeforePlay > cashAfterPlay then
                                successAction = true
                                logConsole(string.format("[%d/%d] UPGRADE Tower #%d DONE", index, #recordedData, targetIdx))
                            elseif action.Type == "SELL" and cashBeforePlay < cashAfterPlay then
                                successAction = true
                                logConsole(string.format("[%d/%d] SELL Tower #%d DONE", index, #recordedData, targetIdx))
                            else
                                retryCount = retryCount + 1
                                logConsole(string.format("[%d/%d] %s Tower #%d Ditolak Server (Mencoba Lagi #%d)...", index, #recordedData, action.Type, targetIdx, retryCount))
                                task.wait(0.8 / selectedSpeed)
                            end
                        else
                            logConsole(string.format("[%d/%d] Model Tower #%d Belum Ada, Menunggu...", index, #recordedData, targetIdx))
                            task.wait(0.5 / selectedSpeed)
                        end
                    until successAction or not isPlaying or retryCount > 15
                end
            end)
        end
        
        isPlaying = false
        playBtn.Text = "Play: OFF"
        playBtn.BackgroundColor3 = Color3.fromRGB(50, 150, 50)
        logConsole("=== PLAYBACK FINISHED ===")
    end)
end

