------------------------------------------------------------------ RECORD
local seqCounter, nextFlush, pending = 0, 1, {}
local knownIds, nameById, liveById = {}, {}, {}
local queue = {}

local function flush()
	while pending[nextFlush] ~= nil do
		local e = pending[nextFlush]
		pending[nextFlush] = nil
		nextFlush += 1
		if e then table.insert(macro, e) end
	end
	saveCurrent()
	refreshCount()
end

local function register(pid, rid, guid, inst)
	if rid then knownIds[rid] = { pid = pid, kind = { t = "ret" } } end
	if guid and guid ~= rid then knownIds[guid] = { pid = pid, kind = { t = "guid" } } end
	if inst then
		claimed[inst] = true
		for _, k in ipairs(keysOf(inst)) do
			if type(k.key) == "string" and k.key ~= rid and k.key ~= guid then
				if knownIds[k.key] then
					knownIds[k.key] = { ambiguous = true }
				else
					knownIds[k.key] = { pid = pid, kind = k.kind }
				end
			end
		end
	end
end

local function resolve(X)
	local info = knownIds[X]
	if info and not info.ambiguous then return info.pid, info.kind end
	local f = getFolder()
	if f then
		for _, inst in ipairs(f:GetChildren()) do
			for _, k in ipairs(keysOf(inst)) do
				if k.key == X then
					local p = getPos(inst)
					if p then
						local best, bd
						for pid, e in pairs(liveById) do
							local d = (Vector3.new(e.x, 0, e.z) - Vector3.new(p.X, 0, p.Z)).Magnitude
							if not bd or d < bd then best, bd = pid, d end
						end
						if best and bd < CFG.MATCH_DIST then return best, k.kind end
					end
				end
			end
		end
	end
end

local function handleRecorded(kind, seq, args, ret, cashBefore, countBefore, snap, tw, tt, tg)
	local tstr = ("W%d +%.1fs"):format(tw or 0, math.max(0, tt or 0))

	-- ABILITY (FireServer: towerId, abilityName)
	if kind == "ability" then
		local X, ab = args[1], args[2]
		log(("TANGKAP ability %s"):format(tostring(ab)))
		local entry = false
		local pid, kd = resolve(X)
		if pid then
			local pe = liveById[pid]
			if pe and not pe.keyKind then pe.keyKind = kd end
			entry = stamp({ type = "ability", id = pid, name = nameById[pid], ability = tostring(ab) }, tw, tt, tg)
			log(("REC ability '%s' -> %s [%s]"):format(tostring(ab), tostring(nameById[pid]), tstr))
		else
			log(("DILEWATI ability %s: tower tidak dikenal id=%s"):format(tostring(ab), tostring(X)))
		end
		pending[seq] = entry
		flush()
		return
	end

	log(("TANGKAP %s ret=%s cash=%s"):format(kind, tostring(ret), fmt(cashBefore)))
	local ok = verifyAction(kind, ret, cashBefore, countBefore)
	local entry = false

	if kind == "place" then
		local name, pos, rot, guid = args[1], args[2], args[3], args[4]
		if typeof(pos) == "Vector3" then
			if ok then
				local inst = findNew(snap, 1.0)
				task.wait(0.15)
				local after = getCash()
				local cost = (cashBefore and after and cashBefore > after) and (cashBefore - after) or nil
				local rid = isGuid(ret) and ret or nil
				local pid = rid or (type(guid) == "string" and guid) or ("p" .. seq)
				entry = stamp({
					type = "place", id = pid, name = name,
					x = pos.X, y = pos.Y, z = pos.Z,
					rot = rot or 0, cost = cost,
				}, tw, tt, tg)
				nameById[pid] = name
				liveById[pid] = entry
				register(pid, rid, type(guid) == "string" and guid or nil, inst)
				log(("REC place %s (%.1f, %.1f, %.1f) cost=%s [%s]"):format(
					tostring(name), pos.X, pos.Y, pos.Z, fmt(cost), tstr))
			else
				log(("SKIP gagal place %s (tidak dicatat)"):format(tostring(name)))
			end
		end
	else
		local X = args[1]
		if ok then
			local pid, kd = resolve(X)
			if not pid then
				log(("DILEWATI %s: tower tidak dikenal id=%s"):format(kind, tostring(X)))
			else
				task.wait(0.15)
				local after = getCash()
				local cost
				if kind == "upgrade" and cashBefore and after and cashBefore > after then
					cost = cashBefore - after
				end
				local pe = liveById[pid]
				if pe and not pe.keyKind then pe.keyKind = kd end
				if kind == "sell" then liveById[pid] = nil end
				entry = stamp({ type = kind, id = pid, name = nameById[pid], cost = cost }, tw, tt, tg)
				log(("REC %s %s cost=%s [%s]"):format(kind, tostring(nameById[pid]), fmt(cost), tstr))
			end
		else
			log(("SKIP gagal %s (tidak dicatat)"):format(kind))
		end
	end

	pending[seq] = entry
	flush()
end

-- Handler jalan di thread game: HANYA ambil data & masukkan ke antrean
G.TMacro_Handler3 = function(self, method, call, ...)
	if not alive or mode ~= "record" then return call(...) end
	local kind = TRACK[self.Name]
	if not kind then return call(...) end
	local args = table.pack(...)
	seqCounter += 1
	local seq = seqCounter
	-- catat wave & waktu game saat aksi dilakukan
	local tw, tt, tg = curWave, gt - waveStartGT, gt - recStartGT
	local okp, cashBefore, countBefore, snap = pcall(function()
		return getCash(), towerCount(), snapshot()
	end)
	if not okp then cashBefore, countBefore, snap = nil, nil, {} end
	local res = table.pack(call(...))
	table.insert(queue, table.pack(kind, seq, args, res[1], cashBefore, countBefore, snap, tw, tt, tg))
	return table.unpack(res, 1, res.n)
end

task.spawn(function()
	while alive do
		local it = table.remove(queue, 1)
		if it then
			task.spawn(function()
				local ok, err = pcall(handleRecorded, table.unpack(it, 1, it.n))
				if not ok then
					log("ERROR catat: " .. tostring(err))
					if pending[it[2]] == nil then pending[it[2]] = false end
					pcall(flush)
				end
			end)
		else
			task.wait(0.05)
		end
	end
end)

local function installHook()
	local key = "4:" .. tostring(game.JobId)
	if G.TMacro_HookKey == key then return true end
	if not (hookmetamethod and getnamecallmethod) then
		log("ERROR: executor tidak support hookmetamethod")
		return false
	end
	local old
	old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
		local method = getnamecallmethod()
		if (method == "InvokeServer" or method == "FireServer")
			and typeof(self) == "Instance" and TRACK[self.Name] and not checkcaller() then
			local h = G.TMacro_Handler3
			if h then
				local s, m = self, method
				local call = function(...)
					if setnamecallmethod then setnamecallmethod(m) end
					return old(s, ...)
				end
				return h(self, m, call, ...)
			end
		end
		return old(self, ...)
	end))
	G.TMacro_HookKey = key
	return true
end

------------------------------------------------------------------ PLAYBACK
local idMap, placeById = {}, {}

local function targetFor(pid)
	local m = idMap[pid]
	if not m then return nil end
	local pe = placeById[pid]
	local kind = pe and pe.keyKind
	if m.rid and (not kind or kind.t == "ret") then return m.rid end
	if kind and kind.t == "guid" then return m.guid end
	if kind and m.inst and m.inst.Parent then
		local v = readKey(m.inst, kind)
		if v then return v end
	end
	return m.rid or m.guid
end

local function doAction(a)
	if a.type == "ability" then
		local ev = eventByName("UpdateAbilityAutoUse")
		local target = targetFor(a.id)
		if not ev or not target then return false end
		task.wait(0.3)
		return (pcall(function() ev:FireServer(target, a.ability) end))
	end

	local remote = remoteByName(REMOTE_OF[a.type])
	if not remote then return false end
	local cashBefore, countBefore, snap = getCash(), towerCount(), snapshot()

	if a.type == "place" then
		local guid = HttpService:GenerateGUID(false):lower()
		local ok, res = pcall(function()
			return remote:InvokeServer(a.name, Vector3.new(a.x, a.y, a.z), a.rot or 0, guid, workspace:GetServerTimeNow())
		end)
		if not ok then return false end
		if verifyAction("place", res, cashBefore, countBefore) then
			local inst = findNew(snap, 1.5)
			if inst then claimed[inst] = true end
			idMap[a.id] = { guid = guid, rid = isGuid(res) and res or nil, inst = inst }
			return true
		end
		return false
	end

	local target = targetFor(a.id)
	if not target then return false end
	local ok, res = pcall(function() return remote:InvokeServer(target) end)
	if not ok then return false end
	return verifyAction(a.type, res, cashBefore, countBefore)
end

-- apakah wave & waktu game sudah sesuai dengan saat direkam?
local function timeReached(a)
	if a.w == nil then return true end -- rekaman lama: tanpa data waktu
	if waveSeen or a.w == 0 then
		if curWave > a.w then return true end
		if curWave < a.w then return false end
		return (gt - waveStartGT) >= (a.t or 0)
	end
	-- label WAVE tidak ditemukan: pakai waktu game total sejak Play
	if a.g == nil then return true end
	return (gt - playStartGT) >= a.g
end

local refreshUI
local function playMacro()
	if #macro == 0 then log("Belum ada rekaman.") mode = "idle" refreshUI() return end
	idMap, placeById, claimed = {}, {}, {}
	local legacy = 0
	for _, a in ipairs(macro) do
		if a.type == "place" then placeById[a.id] = a end
		if a.w == nil then legacy += 1 end
	end
	playStartGT = gt
	if curWave == 0 then waveStartGT = gt end

	log(("PLAY mulai, %d aksi | W%d | speed x%s (timing menyesuaikan speed)"):format(#macro, curWave, tostring(curSpeed)))
	if legacy > 0 then
		log(("%d aksi tanpa data wave/waktu (rekaman lama): dijalankan berurutan. Record ulang untuk timing."):format(legacy))
	end

	for i, a in ipairs(macro) do
		if mode ~= "play" or not alive then break end

		if a.type ~= "place" and not idMap[a.id] then
			log(("[%d/%d] LEWATI %s: tower %s belum ter-place"):format(i, #macro, a.type, tostring(a.name)))
		else
			-- 1) tunggu wave & waktu game sesuai rekaman
			local lastLog = os.clock()
			while mode == "play" and alive and not timeReached(a) do
				if os.clock() - lastLog > 4 then
					lastLog = os.clock()
					log(("[%d/%d] tunggu W%d +%.0fs | sekarang W%d +%.0fs | x%s"):format(
						i, #macro, a.w or 0, a.t or 0, curWave, math.max(0, gt - waveStartGT), tostring(curSpeed)))
				end
				task.wait(0.1)
			end
			if mode ~= "play" or not alive then break end

			-- 2) eksekusi; kalau cash belum cukup, tunggu sampai berhasil (tidak lanjut sebelum sukses)
			local waitStart, lastLog2 = os.clock(), 0
			while mode == "play" and alive do
				local cash = getCash()
				local needWait = a.type ~= "sell" and a.cost and cash and cash < a.cost
					and (os.clock() - waitStart) < CFG.PROBE_AFTER
				if needWait then
					if os.clock() - lastLog2 > 3 then
						lastLog2 = os.clock()
						log(("[%d/%d] waktu OK, tunggu cash %s/%s (%s %s)"):format(i, #macro, fmt(cash), fmt(a.cost), a.type, tostring(a.name)))
					end
					task.wait(0.2)
				elseif doAction(a) then
					if a.type == "ability" then
						log(("[%d/%d] OK ability '%s' %s | W%d +%.0fs"):format(i, #macro, tostring(a.ability), tostring(a.name), curWave, math.max(0, gt - waveStartGT)))
					else
						log(("[%d/%d] OK %s %s | W%d +%.0fs cash=%s"):format(i, #macro, a.type, tostring(a.name), curWave, math.max(0, gt - waveStartGT), fmt(getCash())))
					end
					if a.type == "sell" then idMap[a.id] = nil end
					break
				else
					if os.clock() - lastLog2 > 3 then
						lastLog2 = os.clock()
						log(("[%d/%d] gagal %s %s (cash kurang?), coba lagi. cash=%s"):format(i, #macro, a.type, tostring(a.name), fmt(getCash())))
					end
					task.wait(CFG.RETRY_DELAY)
				end
			end
		end
	end

	if mode == "play" then log("PLAY selesai.") end
	mode = "idle"
	refreshUI()
end

